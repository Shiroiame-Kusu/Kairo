<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:vm="clr-namespace:Kairo.ViewModels"
        x:Class="Kairo.Components.DownloadFrpcWindow"
        x:CompileBindings="True"
        x:DataType="vm:DownloadFrpcWindowViewModel"
        Title="下载 FRPC" Width="460" Height="280" MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16" RowSpacing="12">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <Panel VerticalAlignment="Top" Margin="0,2,0,0">
          <fa:FASymbolIcon Symbol="Important" FontSize="14" IsVisible="{Binding IsFailed}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
          <fa:FASymbolIcon Symbol="Checkmark" FontSize="14" IsVisible="{Binding IsCompleted}"
                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
        </Panel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="6">
      <ProgressBar Minimum="0" Maximum="100" IsVisible="{Binding ShowProgress}"
                   IsIndeterminate="{Binding IsIndeterminate}"
                   Value="{Binding ProgressValue}" />
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowProgress}">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProgressText}" />
        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding SpeedText}" />
      </Grid>
      <TextBlock FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsFailed}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="可以稍后重试，或在「设置 → 国内镜像」中切换下载源后再试" />
      <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding TipText}"
                 Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="accent" MinWidth="80" Command="{Binding RetryCommand}" IsVisible="{Binding IsFailed}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <fa:FASymbolIcon Symbol="Refresh" FontSize="14" />
          <TextBlock Text="重试" />
        </StackPanel>
      </Button>
      <Button MinWidth="80" Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
      <Button MinWidth="80" Content="关闭" Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}" />
    </StackPanel>
  </Grid>
</Window>
