<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:Kairo.ViewModels"
  xmlns:l="using:Kairo.Localization"
        x:Class="Kairo.Components.NodePingWindow"
        x:CompileBindings="True"
        x:DataType="vm:NodePingWindowViewModel"
        Title="{l:Loc ping.windowTitle}" Width="650" Height="480" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">
    <TextBlock Text="{l:Loc ping.subtitle}" Margin="0,0,0,8"/>
    <DataGrid x:Name="PingDataGrid" Grid.Row="1" AutoGenerateColumns="False"
              HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding SortedRows}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Loc ping.column.node}" Binding="{Binding Node}" Width="160"
                             x:DataType="vm:NodePingRow"/>
        <DataGridTextColumn Header="{l:Loc ping.column.host}" Binding="{Binding Host}" Width="*"
                             x:DataType="vm:NodePingRow"/>
        <DataGridTextColumn Header="{l:Loc ping.column.latency}" Binding="{Binding LatencyDisplay}" Width="120"
                 SortMemberPath="LatencySort"
                 x:DataType="vm:NodePingRow"/>
        <DataGridTextColumn Header="{l:Loc ping.column.status}" Binding="{Binding Status}" Width="120"
                             x:DataType="vm:NodePingRow"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="{Binding StatusText}"/>
      <Button Content="{l:Loc common.close}" Command="{Binding CloseCommand}"/>
    </StackPanel>
  </Grid>
</Window>
