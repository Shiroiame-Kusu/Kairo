<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Kairo.ViewModels"
             xmlns:conv="clr-namespace:Kairo.Utils.Converters"
             x:Class="Kairo.Components.DashBoard.StatusPage"
             x:DataType="vm:StatusPageViewModel">
  <UserControl.Resources>
    <conv:LogLineToControlConverter x:Key="LogLineToControlConverter" />
    <DataTemplate x:Key="LogLineTemplate" x:DataType="vm:LogEntry">
      <ContentControl Content="{Binding Converter={StaticResource LogLineToControlConverter}}" />
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Ellipse.running-dot">
      <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="Ellipse.running-dot.active">
      <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
  </UserControl.Styles>
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <fa:FASymbolIcon Symbol="Code" FontSize="22" />
            <TextBlock Text="运行状态" FontSize="24" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="查看日志与进程状态" Opacity="0.8" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
          <Ellipse Classes="running-dot" Classes.active="{Binding HasRunning}" Width="8" Height="8" VerticalAlignment="Center" />
          <TextBlock Text="{Binding RunningText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="8">
      <Panel>
        <ScrollViewer x:Name="LogScroll">
          <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource LogLineTemplate}" />
        </ScrollViewer>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsVisible="{Binding !HasLines}">
          <fa:FASymbolIcon Symbol="Document" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          <TextBlock Text="暂无日志" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="启动隧道后，frpc 的输出会显示在这里" FontSize="12" HorizontalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
        <Button x:Name="JumpToBottomBtn" IsVisible="False" Click="JumpToBottom_OnClick"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8"
                ToolTip.Tip="回到最新日志并恢复自动滚动">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="ChevronDown" FontSize="14" />
            <TextBlock Text="回到底部" />
          </StackPanel>
        </Button>
      </Panel>
    </Border>

    <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Command="{Binding StopAllCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Stop" FontSize="14" />
            <TextBlock Text="强制结束所有隧道" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Command="{Binding CopyCommand}" ToolTip.Tip="复制全部日志，便于反馈问题">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Copy" FontSize="14" />
            <TextBlock Text="复制日志" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3" Command="{Binding ClearCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <fa:FASymbolIcon Symbol="Clear" FontSize="14" />
            <TextBlock Text="清空" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
