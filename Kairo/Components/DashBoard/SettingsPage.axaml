<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Kairo.ViewModels"
             xmlns:l="using:Kairo.Localization"
             xmlns:controls="clr-namespace:Kairo.Controls"
             x:Class="Kairo.Components.DashBoard.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             VerticalAlignment="Stretch">
  <UserControl.Styles>
    <Style Selector="Border.settings-nav-item">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.settings-nav-item:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.settings-nav-item.active">
      <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
    </Style>
    <Style Selector="Border.settings-card">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    </Style>
    <Style Selector="Border.settings-item">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="TextBlock.item-description">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="12">
    <Border Grid.Row="0" CornerRadius="8" Padding="14,10" Background="{DynamicResource LayerFillColorDefaultBrush}">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <fa:FASymbolIcon Symbol="Settings" FontSize="22" />
          <TextBlock Text="{l:Loc settings.title}" FontSize="26" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{l:Loc settings.subtitle}" Opacity="0.8" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="auto,*" ColumnSpacing="12">
      <Border Grid.Column="0" Classes="settings-card" VerticalAlignment="Stretch">
        <StackPanel Spacing="4">
          <Border x:Name="NavGeneral" Tag="general" Classes="settings-nav-item active" PointerPressed="NavItem_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fa:FASymbolIcon Symbol="Home" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{l:Loc settings.section.general}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="NavAppearance" Tag="appearance" Classes="settings-nav-item" PointerPressed="NavItem_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fa:FASymbolIcon Symbol="DarkTheme" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{l:Loc settings.section.appearance}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="NavUpdate" Tag="update" Classes="settings-nav-item" PointerPressed="NavItem_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fa:FASymbolIcon Symbol="CloudDownload" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{l:Loc settings.section.update}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="NavAccount" Tag="account" Classes="settings-nav-item" PointerPressed="NavItem_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fa:FASymbolIcon Symbol="Contact" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{l:Loc settings.section.account}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border x:Name="NavAbout" Tag="about" Classes="settings-nav-item" PointerPressed="NavItem_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <fa:FASymbolIcon Symbol="Help" FontSize="14" />
              <TextBlock Grid.Column="1" Text="{l:Loc settings.section.about}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="ContentScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <Border x:Name="SectionGeneral" Classes="settings-card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{l:Loc settings.section.general}" />
              <Border Classes="settings-item">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{l:Loc settings.frpc.path}" />
                      <TextBlock Classes="item-description" Text="{Binding FrpcStatusText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="SelectFile_OnClick" ToolTip.Tip="{l:Loc settings.frpc.chooseTip}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="OpenFile" FontSize="14" />
                        <TextBlock Text="{l:Loc settings.frpc.choose}" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="DownloadFrpcBtn" Click="DownloadFrpcBtn_OnClick">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Download" FontSize="14" />
                        <TextBlock Text="{Binding FrpcDownloadButtonText}" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBox Grid.Row="1" IsReadOnly="True" Text="{Binding FrpcPath}" PlaceholderText="{l:Loc settings.frpc.notSet}" HorizontalAlignment="Stretch" />
                </Grid>
              </Border>
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.mirror.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.mirror.description}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseMirror, Mode=TwoWay}" />
                </Grid>
              </Border>
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.dataDir.title}" />
                    <TextBlock Classes="item-description" Text="{Binding ConfigDirectory}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Click="OpenConfigDir_OnClick" ToolTip.Tip="{l:Loc settings.dataDir.tip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <fa:FASymbolIcon Symbol="OpenFolder" FontSize="14" />
                      <TextBlock Text="{l:Loc settings.dataDir.open}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="SectionAppearance" Classes="settings-card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{l:Loc settings.section.appearance}" />
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.theme.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.theme.description}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" MinWidth="140" ItemsSource="{Binding ThemeOptions}"
                            SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="l:LocalizedOption">
                        <TextBlock Text="{Binding Text}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
              </Border>
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc language.label}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.language.description}" />
                  </StackPanel>
                  <controls:LanguageSelector Grid.Column="1" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="SectionUpdate" Classes="settings-card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{l:Loc settings.section.update}" />
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.appUpdate.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.appUpdate.description}" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="CheckUpdateBtn" Click="CheckUpdateBtn_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <fa:FASymbolIcon Symbol="Sync" FontSize="14" />
                      <TextBlock Text="{l:Loc settings.appUpdate.check}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Border Classes="settings-item" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.branch.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.branch.description}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="200" SelectedIndex="{Binding UpdateBranchIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Release"/>
                    <ComboBoxItem Content="ReleaseCandidate"/>
                    <ComboBoxItem Content="Beta"/>
                    <ComboBoxItem Content="Alpha"/>
                  </ComboBox>
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="SectionAccount" Classes="settings-card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{l:Loc settings.section.account}" />
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.provider.title}" />
                    <TextBlock Classes="item-description" Text="{Binding AccountText}" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="SwitchProviderBtn" IsVisible="{Binding CanSwitchProvider}"
                          Click="SwitchProviderBtn_OnClick" ToolTip.Tip="{l:Loc settings.provider.switchTip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <fa:FASymbolIcon Symbol="Switch" FontSize="14" />
                      <TextBlock Text="{l:Loc settings.provider.switch}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.security.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.security.description}" />
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="CopyTokenBtn" Click="CopyTokenBtn_OnClick" IsVisible="{Binding CanCopyToken}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <fa:FASymbolIcon Symbol="Copy" FontSize="14" />
                      <TextBlock Text="{l:Loc settings.security.copyToken}" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" x:Name="SignOutBtn" Click="SignOutBtn_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <fa:FASymbolIcon Symbol="LeaveChat" FontSize="14" />
                      <TextBlock Text="{l:Loc settings.security.signOut}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>
              <Border Classes="settings-item" IsVisible="False">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{l:Loc settings.debug.title}" />
                    <TextBlock Classes="item-description" Text="{l:Loc settings.debug.description}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding DebugMode, Mode=TwoWay}" />
                </Grid>
              </Border>
              <StackPanel Spacing="8" IsVisible="False">
                <Button x:Name="EasterEggBtn" Content="{l:Loc settings.easterEgg.button}" Click="EasterEggBtn_OnClick" HorizontalAlignment="Left"/>
                <TextBlock Text="{l:Loc settings.easterEgg.hint}"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="SectionAbout" Classes="settings-card">
            <StackPanel Spacing="10">
              <TextBlock Classes="section-title" Text="{l:Loc settings.section.about}" />
              <Border Classes="settings-item">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DeveloperText}" FontSize="12" />
                    <TextBlock Text="{Binding CopyrightText}" FontSize="12" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <HyperlinkButton Content="{l:Loc settings.about.repository}" Padding="4,2" HorizontalAlignment="Right" NavigateUri="https://github.com/Shiroiame-Kusu/Kairo" />
                    <HyperlinkButton Content="{l:Loc settings.about.issues}" Padding="4,2" HorizontalAlignment="Right" NavigateUri="https://github.com/Shiroiame-Kusu/Kairo/issues" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border Classes="settings-item">
                <TextBlock Classes="item-description" Text="{Binding BuildInfoText}" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
