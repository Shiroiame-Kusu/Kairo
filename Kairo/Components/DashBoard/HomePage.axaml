<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:Kairo.ViewModels"
             xmlns:l="using:Kairo.Localization"
             x:Class="Kairo.Components.DashBoard.HomePage"
             x:DataType="vm:HomePageViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="12">
        <Border Grid.Row="0" Classes="card" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <fa:FASymbolIcon Symbol="Home" FontSize="22" />
                        <TextBlock VerticalAlignment="Center" FontSize="24" Text="{Binding WelcomeText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{l:Loc home.subtitle}" Opacity="0.8" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Bottom" CornerRadius="4" Padding="8,2"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding ProviderName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- 关键数据 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Classes="card">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Sync" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Classes="caption" Text="{l:Loc home.bandwidth}" />
                    </StackPanel>
                    <TextBlock Classes="stat-value" Text="{Binding BandwidthText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Cloud" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Classes="caption" Text="{l:Loc home.traffic}" />
                    </StackPanel>
                    <TextBlock Classes="stat-value" Text="{Binding TrafficText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Calendar" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Classes="caption" Text="{l:Loc home.dailyCheckIn}" />
                    </StackPanel>
                    <Button Classes="accent" HorizontalAlignment="Left" Command="{Binding SignCommand}" IsVisible="{Binding SignButtonVisible}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fa:FASymbolIcon Symbol="Accept" FontSize="14" />
                            <TextBlock Text="{l:Loc home.checkIn}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding SignedBorderVisible}" Margin="0,4,0,0">
                        <fa:FASymbolIcon Symbol="Checkmark" FontSize="16" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock VerticalAlignment="Center" Text="{l:Loc home.checkedIn}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Text="{l:Loc home.unavailable}" IsVisible="{Binding SignUnavailable}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <!-- 账号 -->
            <Border Grid.Column="0" Classes="card" MinWidth="210">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True"
                                Background="{DynamicResource LayerFillColorAltBrush}">
                            <Panel>
                                <fa:FASymbolIcon Symbol="Contact" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding UserNameText}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            <TextBlock Classes="caption" Text="{Binding ProviderName}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Classes="caption" Text="UID" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding UserIdText}" />
                        <TextBlock Grid.Row="1" Classes="caption" Text="{l:Loc home.status}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LoginStatusText}" />
                        <TextBlock Grid.Row="2" Classes="caption" Text="{l:Loc home.email}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UserEmailText}" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 公告 -->
            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <fa:FASymbolIcon Symbol="Alert" FontSize="14" />
                            <TextBlock Text="{l:Loc home.announcement}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <fa:FAProgressRing Width="16" Height="16" IsActive="{Binding IsAnnouncementLoading}"
                                               IsVisible="{Binding IsAnnouncementLoading}" />
                            <Button Theme="{StaticResource TransparentButton}" Padding="6,4" ToolTip.Tip="{l:Loc home.refreshAnnouncement}"
                                    Command="{Binding RefreshAnnouncementCommand}">
                                <fa:FASymbolIcon Symbol="Refresh" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <SelectableTextBlock Text="{Binding Announcement}" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
