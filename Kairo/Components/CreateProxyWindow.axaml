<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:vm="clr-namespace:Kairo.ViewModels"
        xmlns:l="using:Kairo.Localization"
        x:Class="Kairo.Components.CreateProxyWindow"
        x:CompileBindings="True"
        x:DataType="vm:CreateProxyWindowViewModel"
        Title="{l:Loc create.windowTitle}" Width="540" Height="660" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.group-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20,16" RowSpacing="12">
    <StackPanel Spacing="2">
      <TextBlock Text="{l:Loc create.title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{l:Loc create.subtitle}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10" Margin="0,0,12,0">
        <TextBlock Classes="group-title" Text="{l:Loc create.basicInfo}" />
        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
          <StackPanel>
            <TextBlock Classes="field-label" Text="{l:Loc create.name}" />
            <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="{l:Loc create.namePlaceholder}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="field-label" Text="{l:Loc create.type}" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="group-title" Text="{l:Loc create.localService}" />
        <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
          <StackPanel>
            <TextBlock Classes="field-label" Text="{l:Loc create.localIp}" />
            <TextBox Text="{Binding LocalIp, Mode=TwoWay}" PlaceholderText="127.0.0.1" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="field-label" Text="{l:Loc create.localPort}" />
            <TextBox Text="{Binding LocalPort, Mode=TwoWay}" PlaceholderText="{l:Loc create.localPortPlaceholder}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="group-title" Text="{l:Loc create.nodeSection}" />
        <StackPanel>
          <TextBlock Classes="field-label" Text="{l:Loc create.node}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      PlaceholderText="{Binding NodePlaceholder}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CreateProxyWindowViewModel+NodeItem">
                  <TextBlock Text="{Binding DisplayLabel}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <fa:FAProgressRing Grid.Column="1" Width="20" Height="20" IsActive="{Binding IsLoadingNodes}" IsVisible="{Binding IsLoadingNodes}" />
            <Button Grid.Column="2" Command="{Binding PingCommand}" IsEnabled="{Binding CanPing}" IsVisible="{Binding CanPing}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fa:FASymbolIcon Symbol="Clock" FontSize="14" />
                <TextBlock Text="{l:Loc create.ping}" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>

        <Border Padding="10" CornerRadius="6" Background="{DynamicResource LayerFillColorAltBrush}"
                DataContext="{Binding SelectedNode}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="4" x:DataType="vm:CreateProxyWindowViewModel+NodeItem">
            <TextBlock TextWrapping="Wrap">
              <Run Text="{l:Loc create.nodeName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Run Text="{Binding DisplayName, TargetNullValue=—}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
              <Run Text="{l:Loc create.nodePorts}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Run Text="{Binding PortRangeDisplay, TargetNullValue=—}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap">
              <Run Text="{l:Loc create.nodeDescription}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <Run Text="{Binding DescriptionDisplay, TargetNullValue=—}"/>
            </TextBlock>
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding NeedRemotePort}">
          <TextBlock Classes="field-label" Text="{l:Loc create.remotePort}" />
          <TextBox Text="{Binding RemotePort, Mode=TwoWay}" PlaceholderText="{l:Loc create.remotePortPlaceholder}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding NeedDomain}">
          <TextBlock Classes="field-label" Text="{l:Loc create.domain}" />
          <TextBox Text="{Binding Domain, Mode=TwoWay}" PlaceholderText="example.com" />
        </StackPanel>

        <StackPanel IsVisible="{Binding NeedSecretKey}">
          <TextBlock Classes="field-label" Text="{l:Loc create.secretKey}" />
          <TextBox Text="{Binding SecretKey, Mode=TwoWay}" PlaceholderText="{l:Loc create.secretKeyPlaceholder}" />
        </StackPanel>

        <TextBlock Classes="group-title" Text="{l:Loc create.advanced}" IsVisible="{Binding ShowAdvancedOptions}" />
        <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding ShowAdvancedOptions}">
          <CheckBox Content="{l:Loc create.encryption}" IsChecked="{Binding UseEncryption}" ToolTip.Tip="{l:Loc create.encryptionTip}" />
          <CheckBox Content="{l:Loc create.compression}" IsChecked="{Binding UseCompression}" ToolTip.Tip="{l:Loc create.compressionTip}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Classes="status" Classes.error="{Binding IsStatusError}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" />
      <Button Grid.Column="1" Classes="accent" MinWidth="88" IsDefault="True" Command="{Binding CreateCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <fa:FASymbolIcon Symbol="Add" FontSize="14" />
          <TextBlock Text="{l:Loc create.create}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2" MinWidth="88" IsCancel="True" Content="{l:Loc common.cancel}" Command="{Binding CancelCommand}" />
    </Grid>
  </Grid>
</Window>
