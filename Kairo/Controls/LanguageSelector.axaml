<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Kairo.Localization"
             x:Class="Kairo.Controls.LanguageSelector">
  <ComboBox x:Name="Selector" MinWidth="140" HorizontalAlignment="Stretch"
            ToolTip.Tip="{l:Loc language.label}">
    <ComboBox.ItemTemplate>
      <DataTemplate x:DataType="l:LanguageOption">
        <TextBlock Text="{Binding DisplayName}" />
      </DataTemplate>
    </ComboBox.ItemTemplate>
  </ComboBox>
</UserControl>
